{
  "name": "@juspay-tech/react-native-hyperswitch-vault",
  "version": "1.0.0",
  "description": "Hyperswitch card form for React Native. Authored in ReScript, published as JavaScript with genType-generated TypeScript declarations.",
  "license": "Apache-2.0",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/public.d.ts",
  "react-native": "dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/public.d.ts",
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./host": {
      "types": "./dist/types/host.d.ts",
      "react-native": "./dist/esm/host.js",
      "import": "./dist/esm/host.js",
      "require": "./dist/cjs/host.js",
      "default": "./dist/esm/host.js"
    },
    "./orchestration": {
      "types": "./dist/types/orchestration.d.ts",
      "react-native": "./dist/esm/orchestration.js",
      "import": "./dist/esm/orchestration.js",
      "require": "./dist/cjs/orchestration.js",
      "default": "./dist/esm/orchestration.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm/**",
    "dist/cjs/**",
    "dist/types/**",
    "dist/assets/**",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!dist/**/*.map",
    "!shared-code",
    "!shared-code/**"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "re:build": "rescript",
    "re:clean": "rescript clean",
    "types": "tsc -p tsconfig.build.json",
    "bundle": "rollup -c",
    "build": "rescript && tsc -p tsconfig.build.json && rollup -c",
    "build:clean": "rescript clean && rescript && tsc -p tsconfig.build.json && rollup -c",
    "clean": "rescript clean",
    "prepack": "rescript && tsc -p tsconfig.build.json && rollup -c"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@babel/runtime": "^7.25.0",
    "@rescript/core": "1.6.1",
    "@rescript/react": "0.13.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@types/react": "19.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.7",
    "rescript": "11.1.4",
    "rescript-react-native": "0.77.4",
    "rollup": "^4.24.0",
    "typescript": "^5.6.0"
  },
  "hyperswitch": {
    "sdkUtilsCommit": "1669cc28955bf547b7fe35d6401ea47720019ff9"
  }
}
