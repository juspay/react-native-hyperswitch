{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": false,
    "outDir": "dist/types",
    "rootDir": "src",
    // React Native's own globals.d.ts. The stock RN tsconfig has no "dom" lib, so this must
    // resolve exactly the way a consumer's does.
    "types": [
      "react-native"
    ]
  },
  "include": [
    "src/public.ts",
    "src/orchestration.ts",
    "src/host.ts",
    "src/jsx-global.ts",
    "src/merchantTypes.ts",
    "src/styleTypes.ts",
    "src/telemetryTypes.ts",
    "src/*.gen.tsx",
    "src/bs-modules.d.ts"
  ]
}
