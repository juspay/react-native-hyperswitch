{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": false,
    "outDir": "dist/types",
    "rootDir": "src",
    "types": [
      "react-native"
    ]
  },
  "include": [
    "src/index.ts",
    "src/jsonValue.ts",
    "src/*.gen.tsx",
    "src/bs-modules.d.ts"
  ]
}
