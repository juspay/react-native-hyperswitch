{
  "name": "react-native-hyperswitch-libraries",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo for React Native Hyperswitch libraries",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lerna": "lerna",
    "release": "release-it",
    "example": "yarn workspace react-native-hyperswitch-example",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "workspaces": [
    "packages/@juspay-tech/*",
    "shared/*",
    "example"
  ],
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native/eslint-config": "^0.79.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "commitlint": "^17.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "lerna": "^8.2.2",
    "prettier": "^2.0.5",
    "release-it": "^19.0.5"
  },
  "author": "Hyperswitch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juspay/react-native-hyperswitch"
  },
  "bugs": {
    "url": "https://github.com/juspay/react-native-hyperswitch/issues"
  },
  "homepage": "https://hyperswitch.io",
  "publishConfig": {
    "access": "public"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "packageManager": "yarn@3.6.1"
}
